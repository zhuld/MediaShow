<Window x:Class="MediaShow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaShow 设置"
        Icon="Resources/server.ico"
        Width="840" Height="720"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,10,0,0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Background="Transparent" Margin="6,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <StackPanel>
                <TextBlock Text="设置"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ConfigPathText"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16,0,16,8">
            <TabItem Header="基本设置">
                <Border Style="{StaticResource CardBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="计算机名 (PcName)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PcNameBox" Margin="0,5,0,0"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="UDP 指令格式为“计算机名-模式名”，例如 PC_1-Single，因此不能包含“-”。"/>

                            <TextBlock Text="UDP 监听端口 (UdpPort)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                            <TextBox x:Name="UdpPortBox" Width="160" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="取值范围 1～65535，修改后会立即重启 UDP 控制服务。"/>

                            <TextBlock Text="网页设置端口 (WebPort)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                            <TextBox x:Name="WebPortBox" Width="160" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="默认 8000，浏览器访问 http://本机IP:端口/ 即可远程修改配置；0 表示关闭网页设置。"/>

                            <TextBlock Text="默认模式 (DefaultMode)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                            <ComboBox x:Name="DefaultModeCombo"
                                      Width="240"
                                      HorizontalAlignment="Left"
                                      Margin="0,5,0,0"
                                      SelectionChanged="DefaultModeCombo_SelectionChanged"/>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="程序启动时使用的布局模式，可选内置的“Blank”（纯黑屏）或“Desktop”（隐藏窗口以显示桌面）。"/>

                            <TextBlock Text="窗口尺寸 (WindowWidth / WindowHeight)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                            <Grid Width="360" HorizontalAlignment="Left" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="宽度（像素）" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="WindowWidthBox" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="×" Margin="10,18,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="高度（像素）" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="WindowHeightBox" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="单位是物理像素，程序会按当前屏幕 DPI 自动换算；任一项设置为 0 表示启动时铺满全屏（如 0 / 720 即全屏）。"/>

                            <CheckBox x:Name="ShowModeStatusBarCheckBox"
                                      Content="显示模式状态栏"
                                      Margin="0,12,0,0"
                                      ToolTip="模式切换后在窗口底部短暂显示当前模式名称。"/>

                            <Border Background="#F1F5F9" BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="4" Padding="9,5" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="WindowStatusText"
                                           FontSize="11.5"
                                           Foreground="#374151"
                                           TextWrapping="Wrap"
                                           Text="当前窗口实际尺寸：读取中…"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="布局模式">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="ModeList"
                                     Grid.Row="0"
                                     BorderThickness="0"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="ModeList_SelectionChanged"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="添加" Style="{StaticResource SecondaryButton}" MinWidth="62"
                                        Margin="0,0,8,0" Click="AddMode_Click"/>
                                <Button Content="删除" Style="{StaticResource SecondaryButton}" MinWidth="62"
                                        Click="RemoveMode_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ModeDetailPanel" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="14,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模式名称" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="ModeNameBox"
                                         Grid.Column="1"
                                         MaxWidth="260"
                                         HorizontalAlignment="Left"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource FieldHint}"
                                       Margin="0,8,0,8"
                                       Text="视图按顺序左右排列，最多显示 2 个；宽高为像素值（按 96 DPI 换算）。"/>

                            <DataGrid x:Name="ViewsGrid" Grid.Row="2" ItemsSource="{Binding Views}">
                                <DataGrid.Columns>
                                    <DataGridComboBoxColumn x:Name="CameraIdColumn"
                                                            Header="摄像头"
                                                            Width="*"
                                                            SelectedValueBinding="{Binding CameraId}"/>
                                    <DataGridTextColumn Header="宽度 (W)" Width="110"
                                                        Binding="{Binding W, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="高度 (H)" Width="110"
                                                        Binding="{Binding H, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="添加视图" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Click="AddView_Click"/>
                                <Button Content="删除视图" Style="{StaticResource SecondaryButton}"
                                        Click="RemoveView_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="摄像头">
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource FieldHint}"
                                   Margin="0,0,0,10"
                                   Text="摄像头清单在程序启动时自动扫描生成，并会覆盖 config.json 中的 CameraSources，因此这里仅作查看；视图的摄像头归属可在“布局模式”中修改。"/>
                        <DataGrid x:Name="CameraGrid" Grid.Row="1" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"/>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="索引" Binding="{Binding Index}" Width="70"/>
                                <DataGridTextColumn Header="宽" Binding="{Binding Width}" Width="70"/>
                                <DataGridTextColumn Header="高" Binding="{Binding Height}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Button Content="打开配置文件位置"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Click="OpenConfigFolder_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0"/>
                    <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
